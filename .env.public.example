# Copy to .env.public, replace every placeholder, then chmod 600 .env.public.
# Secret entries below are deliberately unusable placeholders, not credentials.
PROXY_HOST_PORT=8010
WS_TOKEN=REPLACE_WITH_openssl_rand_hex_32
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=REPLACE_BEFORE_START
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
HERMES_DASHBOARD_BASIC_AUTH_SECRET=REPLACE_WITH_openssl_rand_hex_32
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
